<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_judo" model="ir.module.category">
        <field name="name">Club de judo</field>
        <field name="sequence">40</field>
    </record>

    <!-- Secrétariat : adhérents, adhésions, cours, lecture des cotisations -->
    <record id="group_judo_user" model="res.groups">
        <field name="name">Secrétariat</field>
        <field name="category_id" ref="module_category_judo"/>
        <field name="comment">Gère les adhérents, les adhésions et les inscriptions aux cours.</field>
    </record>

    <!-- Trésorerie : facturation, cotisations, licences, transactions -->
    <record id="group_judo_treasurer" model="res.groups">
        <field name="name">Trésorier</field>
        <field name="category_id" ref="module_category_judo"/>
        <field name="implied_ids" eval="[(4, ref('group_judo_user')), (4, ref('account.group_account_invoice'))]"/>
        <field name="comment">Génère les cotisations, facture, saisit les transactions et consulte la situation financière.</field>
    </record>

    <!-- Administration : tout, y compris la configuration -->
    <record id="group_judo_manager" model="res.groups">
        <field name="name">Administrateur</field>
        <field name="category_id" ref="module_category_judo"/>
        <field name="implied_ids" eval="[(4, ref('group_judo_treasurer'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Accès complet, y compris la configuration et la suppression des données.</field>
    </record>

    <!-- Multi-société : chaque club ne voit que ses propres données.
         Un utilisateur ne voit que les sociétés sélectionnées dans le sélecteur. -->
    <record id="rule_judo_season_company" model="ir.rule">
        <field name="name">Saisons : société</field>
        <field name="model_id" ref="model_judo_season"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_judo_member_category_company" model="ir.rule">
        <field name="name">Catégories d'adhérents : société</field>
        <field name="model_id" ref="model_judo_member_category"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_judo_member_company" model="ir.rule">
        <field name="name">Adhérents : société</field>
        <field name="model_id" ref="model_judo_member"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_judo_membership_company" model="ir.rule">
        <field name="name">Adhésions : société</field>
        <field name="model_id" ref="model_judo_membership"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_judo_group_company" model="ir.rule">
        <field name="name">Groupes : société</field>
        <field name="model_id" ref="model_judo_group"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_judo_course_company" model="ir.rule">
        <field name="name">Cours : société</field>
        <field name="model_id" ref="model_judo_course"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_judo_enrollment_company" model="ir.rule">
        <field name="name">Inscriptions : société</field>
        <field name="model_id" ref="model_judo_enrollment"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_judo_fee_company" model="ir.rule">
        <field name="name">Cotisations : société</field>
        <field name="model_id" ref="model_judo_fee"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_judo_licence_company" model="ir.rule">
        <field name="name">Licences : société</field>
        <field name="model_id" ref="model_judo_licence"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_judo_bank_account_company" model="ir.rule">
        <field name="name">Comptes et caisses : société</field>
        <field name="model_id" ref="model_judo_bank_account"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_judo_transaction_category_company" model="ir.rule">
        <field name="name">Catégories de transactions : société</field>
        <field name="model_id" ref="model_judo_transaction_category"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_judo_transaction_company" model="ir.rule">
        <field name="name">Transactions : société</field>
        <field name="model_id" ref="model_judo_transaction"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
