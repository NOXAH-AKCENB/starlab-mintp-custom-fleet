<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Groupes -->
    <record id="view_judo_group_tree" model="ir.ui.view">
        <field name="name">judo.group.tree</field>
        <field name="model">judo.group</field>
        <field name="arch" type="xml">
            <tree string="Groupes">
                <field name="name"/>
                <field name="age_min"/>
                <field name="age_max"/>
                <field name="grade_min"/>
            </tree>
        </field>
    </record>

    <record id="view_judo_group_form" model="ir.ui.view">
        <field name="name">judo.group.form</field>
        <field name="model">judo.group</field>
        <field name="arch" type="xml">
            <form string="Groupe">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="age_min"/>
                            <field name="age_max"/>
                            <field name="grade_min"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                    <field name="course_ids">
                        <tree>
                            <field name="name"/>
                            <field name="schedule"/>
                            <field name="instructor"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_judo_group" model="ir.actions.act_window">
        <field name="name">Groupes</field>
        <field name="res_model">judo.group</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Cours -->
    <record id="view_judo_course_tree" model="ir.ui.view">
        <field name="name">judo.course.tree</field>
        <field name="model">judo.course</field>
        <field name="arch" type="xml">
            <tree string="Cours">
                <field name="name"/>
                <field name="season_id"/>
                <field name="group_id"/>
                <field name="schedule"/>
                <field name="instructor"/>
                <field name="room"/>
                <field name="enrolled_count" string="Inscrits"/>
                <field name="capacity"/>
            </tree>
        </field>
    </record>

    <record id="view_judo_course_form" model="ir.ui.view">
        <field name="name">judo.course.form</field>
        <field name="model">judo.course</field>
        <field name="arch" type="xml">
            <form string="Cours">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Planning">
                            <field name="season_id"/>
                            <field name="group_id"/>
                            <field name="day_of_week"/>
                            <field name="time_start" widget="float_time"/>
                            <field name="time_end" widget="float_time"/>
                            <field name="schedule"/>
                        </group>
                        <group string="Encadrement">
                            <field name="instructor"/>
                            <field name="room"/>
                            <field name="capacity"/>
                            <field name="enrolled_count"/>
                        </group>
                    </group>
                    <field name="enrollment_ids">
                        <tree>
                            <field name="member_id"/>
                            <field name="date"/>
                            <field name="state" widget="badge"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_judo_course_search" model="ir.ui.view">
        <field name="name">judo.course.search</field>
        <field name="model">judo.course</field>
        <field name="arch" type="xml">
            <search string="Cours">
                <field name="name"/>
                <field name="instructor"/>
                <field name="group_id"/>
                <field name="season_id"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_day" string="Jour" context="{'group_by': 'day_of_week'}"/>
                    <filter name="group_group" string="Groupe" context="{'group_by': 'group_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_judo_course" model="ir.actions.act_window">
        <field name="name">Cours</field>
        <field name="res_model">judo.course</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_judo_course_search"/>
    </record>

    <!-- Inscriptions -->
    <record id="view_judo_enrollment_tree" model="ir.ui.view">
        <field name="name">judo.enrollment.tree</field>
        <field name="model">judo.enrollment</field>
        <field name="arch" type="xml">
            <tree string="Inscriptions">
                <field name="member_id"/>
                <field name="course_id"/>
                <field name="season_id"/>
                <field name="date"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_judo_enrollment_form" model="ir.ui.view">
        <field name="name">judo.enrollment.form</field>
        <field name="model">judo.enrollment</field>
        <field name="arch" type="xml">
            <form string="Inscription">
                <sheet>
                    <group>
                        <field name="member_id"/>
                        <field name="course_id"/>
                        <field name="season_id"/>
                        <field name="date"/>
                        <field name="state"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_judo_enrollment" model="ir.actions.act_window">
        <field name="name">Inscriptions aux cours</field>
        <field name="res_model">judo.enrollment</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
