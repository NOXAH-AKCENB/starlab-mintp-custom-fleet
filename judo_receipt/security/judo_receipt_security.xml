<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_judo_receipt_company" model="ir.rule">
        <field name="name">Reçus : société</field>
        <field name="model_id" ref="model_judo_receipt"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_judo_receipt_line_company" model="ir.rule">
        <field name="name">Lignes de reçu : société</field>
        <field name="model_id" ref="model_judo_receipt_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
